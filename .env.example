# Copy to .env (never commit .env). Read by docker compose and by the backend for local development.
# On Render, set the same variables in the service's Environment settings instead.
ANTHROPIC_API_KEY=sk-ant-...
DATABASE_URL=jdbc:postgresql://localhost:5432/kletsai
DATABASE_USERNAME=kletsai
DATABASE_PASSWORD=kletsai
ALLOWED_ORIGINS=http://localhost:4200
